{"nodes": [{"id": "docs_concepts_librarylayout", "label": "Library layout", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_concepts_ownershiprecovery", "label": "Ownership & recovery", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_concepts_extractiontiers", "label": "Extraction tiers", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promotion only goes up; having full text is a separate fact from tier so acquisition never silently inflates or deflates extraction confidence."}, {"id": "docs_concepts_claimcontract", "label": "The claim contract", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_concepts_relationsedges", "label": "Relations & edges", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "potential_conflict is the only auto-proposed edge type; contradicts requires explicit human review with rationale so disagreements are never silently escalated."}, {"id": "docs_concepts_correctionsoverlay", "label": "Corrections overlay lifecycle", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corrections are appended, never edited in place, and flip to pending_review when underlying evidence changes, so human judgment is preserved as an auditable overlay rather than mutating raw extraction."}, {"id": "docs_concepts_projectsreadingscreening", "label": "Projects, reading states, screening", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_concepts_studiesdatasetsmethods", "label": "Studies, datasets, methods", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as three separate registries because a shared dataset does not prove two papers report the same study; only explicit create-study groups papers."}, {"id": "docs_concepts_peoplefundingcitations", "label": "Researchers, authorship, funding, citations", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_concepts_identifiercontract", "label": "Identifier contract", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three identifier classes (slugs, citekeys, opaque IDs) keep user-facing names collision-refused while machine IDs stay unambiguous; citekeys are the one exception that gets a suffix so manuscripts never break."}, {"id": "docs_concepts_selectorgrammar", "label": "Selector grammar", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared selector grammar resolves to a frozen PMID set copied into every artifact manifest, so a saved comparison or brief never silently changes membership on rerun."}, {"id": "docs_concepts_designdecisions", "label": "Key design decisions (D1-D28)", "file_type": "concept", "source_file": "docs/concepts.html", "source_location": null, "source_url