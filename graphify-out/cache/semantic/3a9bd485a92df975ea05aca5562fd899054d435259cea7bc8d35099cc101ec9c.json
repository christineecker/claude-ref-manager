{"nodes": [{"id": "lessons_0005_weave_and_the_concept_graph", "label": "Lesson 0005: Weave and the Concept Graph", "file_type": "document", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_0005_weave_and_the_concept_graph_inline_judgment", "label": "Inline concept mapping (no dedicated weave subagent)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PLAN.md names only ref-extractor and ref-synthesizer; neither fits, so weave maps inline like /ref:check-citations."}, {"id": "lessons_0005_weave_and_the_concept_graph_find_before_create", "label": "Find-before-create concept matching with aliases", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "concept.py matching is exact, case-insensitive, whitespace-normalized only; judgment about synonyms belongs to the calling agent, near-matches become aliases."}, {"id": "lessons_0005_weave_and_the_concept_graph_potential_conflict", "label": "potential_conflict relation (only deterministic edge type)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "relation.py propose can only detect opposite directions across different PMIDs; supports/extends/replicates need create-manual, and contradicts needs a rationale-required review."}, {"id": "lessons_0005_weave_and_the_concept_graph_mesh_as_aliases", "label": "MeSH terms resolve to concepts via aliases", "file_type": "concept", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_0005_weave_and_the_concept_graph_pure_regeneration", "label": "Pure regeneration of okf/ and people_relations (--regenerate-only)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hand-edit derived views; edit JSONL sources and re-run /ref:weave --regenerate-only."}, {"id": "lessons_0005_weave_and_the_concept_graph_people_relations_separation", "label": "people_relations.jsonl kept separate from relations.jsonl", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two schemas were designed independently and merging was not worth the risk."}, {"id": "lessons_0005_weave_and_the_concept_graph_scope_guardrail", "label": "Weave scope guardrail (selector-bounded, never library-wide)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparing every claim pair library-wide is expensive; only claims mapped to the same concept pair within selected papers are compared."}], "edges": [{"source": "lessons_0005_weave_and_the_concept_graph", "target": "commands_weave", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/teachme/lessons/0005-weave-and-the-concept-graph.html", "source_location": null, "weight": 1.0}, {"source": "lessons_0005_weave_and_the_concept_graph", "target": "scripts_concept", "relation": "cites", "confidence": "EXTRACTE