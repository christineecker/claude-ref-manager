{"nodes": [{"id": "tutorials_graph_discovery", "label": "Graph Discovery Tutorial", "file_type": "document", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_graph_discovery_potential_conflict", "label": "potential_conflict Relation", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic check only proposes potential_conflict, requiring opposite directions and identical comparator, effect measure, timepoint and population; contradicts can only be reached by human review with rationale."}, {"id": "tutorials_graph_discovery_contradicts", "label": "contradicts Relation", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_graph_discovery_relation_review", "label": "Relation Review (review_state, rationale, stale)", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_graph_discovery_concept_registry", "label": "Concept Registry and Aliases", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Find before you mint: exact case/whitespace-insensitive matching, never fuzzy; alias can't be taken from another concept because that would be a merge decision left to the user."}, {"id": "tutorials_graph_discovery_weave", "label": "/ref:weave", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No dedicated subagent; Claude maps claims to concepts inline and scripts only validate and persist. Scoped to selector on purpose; library-wide sweeps are deliberate."}, {"id": "tutorials_graph_discovery_okf_views", "label": "OKF Views (okf/, people_relations.jsonl)", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_graph_discovery_gaps", "label": "/ref:gaps Structural Queries", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Findings cite the IDs they rest on; empty lists describe the library, not evidence robustness."}, {"id": "tutorials_graph_discovery_swanson_abc", "label": "Swanson ABC Traversal (/ref:hypothesize)", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chains with identical PMID sets on both hops are excluded, but partial overlap counts as independent since full separation is too strict. Zero PubMed hits is not novelty."}, {"id": "tutorials_graph_discovery_snowball", "label": "Snowballing (/ref:related)", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forward uses pubmed_pubmed similarity, not a cited-by graph; every row names its method so it can't pass as citation data. Nothing is auto-added."}, {"id": "tutorials_graph_discovery_concept_selector_bug", "label": "--concept Selector NotAvailableError", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_graph_discovery_library_scoped_results", "label": "Library-Scoped Results Principle", "file_type": "rationale", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing edge, empty gap list or zero-result search describes what was added and extracted, not the literature."}, {"id": "tutorials_graph_discovery_claim_registry", "label": "Claim Registry (extracted claims)", "file_type": "concept", "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "tutorials_graph_discovery", "target": "tutorials_dashboard_insights", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "weight": 1.0}, {"source": "tutorials_graph_discovery", "target": "tutorials_graph_discovery_weave", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "weight": 1.0}, {"source": "tutorials_graph_discovery", "target": "tutorials_graph_discovery_concept_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "weight": 1.0}, {"source": "tutorials_graph_discovery", "target": "tutorials_graph_discovery_potential_conflict", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tutorials/graph-discovery.html", "source_location": null, "weight": 1.0}, {"source": "tutorials_graph_discovery", "target": "tutorials_graph_discovery_contradicts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,