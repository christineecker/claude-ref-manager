{"nodes": [{"id": "lessons_0003_acquire_to_extract_pipeline", "label": "Lesson 0003: The Acquire-to-Extract Pipeline", "file_type": "document", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_0003_acquire_to_extract_pipeline_fetch_source_priority", "label": "Fetch source priority (PMC JATS > PubMed full text > Unpaywall > publisher HTML > abstract_only)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JATS is highest fidelity and the only path producing figures.json, so it is tried first; abstract_only is an expected outcome, not a failure."}, {"id": "lessons_0003_acquire_to_extract_pipeline_add_fetch_separation", "label": "add/fetch separation (fetch never creates a paper record)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "add is the explicit identity-resolution step (RESOLVE+DEDUP); folding it into fetch would let acquisition create records without resolution."}, {"id": "lessons_0003_acquire_to_extract_pipeline_per_pmid_independence", "label": "Per-PMID independence (one failure never blocks the batch)", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_0003_acquire_to_extract_pipeline_duplicate_noop", "label": "duplicate_noop on unchanged source hash", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lessons_0003_acquire_to_extract_pipeline_extractor_fan_out", "label": "Parallel ref-extractor fan-out per PMID", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Study-type classification and PICO+ normalization need reading judgment, so extract is the one non-deterministic stage; per-paper independence isolates failures."}, {"id": "lessons_0003_acquire_to_extract_pipeline_unknown_literal_rule", "label": "Literal \"unknown\" rule for undeterminable fields", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing key looks like the extractor forgot to check; \"unknown\" makes the gap visible and machine-checkable."}, {"id": "lessons_0003_acquire_to_extract_pipeline_evidence_span", "label": "evidence_span direct-quote requirement", "file_type": "rationale", "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a human verify normalization against source text without re-reading the whole paper."}], "edges": [{"source": "lessons_0003_acquire_to_extract_pipeline", "target": "reference_pipeline_commands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/teachme/lessons/0003-acquire-to-extract-pipeline.html", "source_location": null, "weight": 1.0}, {"source": "lessons_0003_acquire_to_extract_pipeline", "target": "lessons_0001_paper_repo_anatomy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/teachme/lessons/0003-acquire-to-extrac