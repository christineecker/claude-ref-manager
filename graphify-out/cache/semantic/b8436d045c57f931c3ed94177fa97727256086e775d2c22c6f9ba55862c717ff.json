{"nodes": [{"id": "tutorials_dashboard_insights", "label": "Evidence Insights Tutorial", "file_type": "document", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_dashboard_insights_insights_tab", "label": "Dashboard Insights Tab", "file_type": "concept", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only and deterministic; computed in-browser from one payload so serve and static modes show identical views; every suggested action is a copyable command."}, {"id": "tutorials_dashboard_insights_api_knowledge", "label": "/api/knowledge payload", "file_type": "code", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_dashboard_insights_notable_cards", "label": "Notable Cards", "file_type": "concept", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-connected paper counts concepts and shared-author papers, not claims, so heavily extracted papers don't win on claim count alone."}, {"id": "tutorials_dashboard_insights_evidence_map", "label": "Evidence Map", "file_type": "concept", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tutorials_dashboard_insights_gap_grid", "label": "Population x Outcome Gap Grid", "file_type": "concept", "source_file": "docs/tutorials/dashboard-insights.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies exactly the /ref:gaps --interventi