{"nodes": [{"id": "docs_workflows_commandmap", "label": "Command map (figure 1)", "file_type": "concept", "source_file": "docs/workflows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_workflows_ingestcommit", "label": "Ingest & commit (figure 2)", "file_type": "concept", "source_file": "docs/workflows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-PMID lock serializes writes to one paper while a short-lived library lock only guards citekey allocation, so one paper's failure or slow write never blocks another paper's ingest."}, {"id": "docs_workflows_fulltextacquisition", "label": "Full-text acquisition (figure 3)", "file_type": "concept", "source_file": "docs/workflows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fetch.py tries sources in a fixed priority ladder (JATS, Unpaywall, publisher HTML, plain text, abstract-only) and stops at the first applicable rung, so acquisition never silently mixes source quality."}, {"id": "docs_workflows_extractionfanout", "label": "Extraction fan-out (figure 4)", "file_type": "concept", "source_file": "docs/workflows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ref-extractor subagent per PMID runs in parallel and commits independently, so one paper's malformed claim never blocks or corrupts another paper's extraction."}, {"id": "docs_workflows_refextractor", "label": "ref-extractor subagent", "file_type": "document", "source_file": "docs/workflows.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_workflows_commandmap", "target": "commands_refadd_refaddcommand", "relation": "references", "confidence": "EXTRACTED", "confidence_sco